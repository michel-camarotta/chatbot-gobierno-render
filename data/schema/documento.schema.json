{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "documento.schema.json",
  "title": "Documento de conocimiento",
  "description": "Unidad curada de conocimiento de un bot; sus secciones son la unidad de recuperación RAG (RF-10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titulo", "coleccion", "etiquetas", "resumen", "secciones", "fuente"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador en kebab-case; debe coincidir con el nombre del archivo"
    },
    "titulo": { "type": "string", "minLength": 3, "maxLength": 200 },
    "coleccion": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Debe coincidir con el nombre del directorio que contiene el documento"
    },
    "organismo": { "type": "string" },
    "etiquetas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "description": "Términos y sinónimos de búsqueda (ruteo y recuperación)"
    },
    "resumen": { "type": "string", "minLength": 10, "maxLength": 600 },
    "secciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "contenido"],
        "properties": {
          "titulo": { "type": "string", "minLength": 2 },
          "contenido": { "type": "string", "minLength": 10 }
        }
      }
    },
    "fuente": { "type": "string", "minLength": 2 },
    "enlaceOficial": { "type": "string", "pattern": "^https://" },
    "actualizado": { "type": "string" },
    "relacionados": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
