{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tramite.schema.json",
  "title": "Trámite",
  "description": "Ficha de un trámite público del catálogo del Asistente Ciudadano (RF-04, ADR-02)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nombre",
    "descripcion",
    "organismo",
    "categoria",
    "modalidad",
    "palabrasClave",
    "requisitos",
    "pasos"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador único en kebab-case; debe coincidir con el nombre del archivo"
    },
    "nombre": { "type": "string", "minLength": 3, "maxLength": 200 },
    "descripcion": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "organismo": { "type": "string", "minLength": 3 },
    "departamento": { "type": "string" },
    "categoria": { "type": "string", "minLength": 3 },
    "modalidad": { "type": "string", "enum": ["Presencial", "En línea", "Mixto"] },
    "palabrasClave": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "description": "Sinónimos y términos de búsqueda que usa la ciudadanía (ADR-03)"
    },
    "requisitos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "documentacion": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "pasos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "costo": { "type": "string" },
    "lugar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string" },
        "direccion": { "type": "string" },
        "horario": { "type": "string" },
        "contacto": { "type": "string" }
      }
    },
    "plazoEstimado": { "type": "string" },
    "enlaceOficial": { "type": "string", "pattern": "^https://" },
    "observaciones": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
