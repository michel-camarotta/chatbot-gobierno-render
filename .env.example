# Asistente Ciudadano — configuración por entorno (RNF-04).
# Copiar a .env para desarrollo local. NUNCA commitear .env.

# Puerto HTTP del servicio.
PORT=3001

# Nivel de log: fatal | error | warn | info | debug | trace | silent
# En producción usar info (SEG-05: debug puede incluir contenido de consultas).
LOG_LEVEL=info

# Poner en true si el servicio corre detrás de un proxy/CDN (Render, nginx…)
# para que el rate limiting vea la IP real del cliente.
TRUST_PROXY=false

# Orígenes adicionales autorizados para consumir la API desde el navegador,
# separados por coma. Vacío = solo mismo origen (SEG-03).
# CORS_ORIGINS=https://www.imcanelones.gub.uy,https://tramites.gub.uy
CORS_ORIGINS=

# --- Proveedor de IA (opcional) -------------------------------------------
# Sin OPENAI_API_KEY el asistente opera en modo catálogo: responde con fichas
# determinísticas de los trámites, sin ningún servicio externo (RF-03).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

# --- Retrieval --------------------------------------------------------------
# Cantidad máxima de trámites que se entregan como contexto al modelo (RF-02).
RETRIEVAL_TOP_K=3

# --- Rate limiting (SEG-02) -------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_API_MAX=100
